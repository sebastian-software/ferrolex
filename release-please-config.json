{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "677e61027108f91ab226bd5ab854d5466a60049c",
  "release-type": "rust",
  "include-component-in-tag": true,
  "plugins": [
    {
      "type": "cargo-workspace",
      "updateAllPackages": true
    }
  ],
  "packages": {
    ".": {
      "component": "ferrolex",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "crates/ferrolex-node/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "crates/ferrolex-node/package.json",
          "jsonpath": "$['optionalDependencies']['@ferrolex/node-darwin-arm64']"
        },
        {
          "type": "json",
          "path": "crates/ferrolex-node/package.json",
          "jsonpath": "$['optionalDependencies']['@ferrolex/node-linux-x64-gnu']"
        },
        {
          "type": "json",
          "path": "crates/ferrolex-node/package.json",
          "jsonpath": "$['optionalDependencies']['@ferrolex/node-win32-x64-msvc']"
        },
        {
          "type": "json",
          "path": "crates/ferrolex-node/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "crates/ferrolex-node/package-lock.json",
          "jsonpath": "$['packages']['']['version']"
        },
        {
          "type": "json",
          "path": "crates/ferrolex-node/package-lock.json",
          "jsonpath": "$['packages']['']['optionalDependencies']['@ferrolex/node-darwin-arm64']"
        },
        {
          "type": "json",
          "path": "crates/ferrolex-node/package-lock.json",
          "jsonpath": "$['packages']['']['optionalDependencies']['@ferrolex/node-linux-x64-gnu']"
        },
        {
          "type": "json",
          "path": "crates/ferrolex-node/package-lock.json",
          "jsonpath": "$['packages']['']['optionalDependencies']['@ferrolex/node-win32-x64-msvc']"
        }
      ]
    }
  }
}
